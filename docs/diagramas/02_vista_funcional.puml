@startdot
/'
  Vista 2 — Funcional (diagrama de componentes UML)
  Cubre: RF-01..RF-50 agrupados por bloque funcional (ver docs/DIAGRAMAS.md §2); HU-10, HU-29, HU-30, HU-35, HU-42; RNF-15.
  Notación de la guía: «component», interfaz provista (○ bolita unida al proveedor), interfaz requerida
  (flecha con arco "(" hacia la bolita), puertos como cuadros pequeños en el borde del componente.
  Cliente (ui, client) y servidor (api → application → domain; infrastructure → domain) se hablan por HTTP/JSON
  (el puerto ISaveRepository lo define el dominio y lo implementa el repositorio de MongoDB).
  Posiciones fijadas a mano (layout=neato) para evitar cruces; el marco de color indica la capa.
'/
digraph funcional {
  graph [layout=neato, splines=line, pad=0.5, fontname="Arial", dpi=150, outputorder=nodesfirst, forcelabels=true,
         label="Vista funcional — Valle Verde (diagrama de componentes)\n ", labelloc=t, fontsize=26];
  node  [fontname="Arial", fontsize=13];
  edge  [fontname="Arial", fontsize=12, penwidth=1.3, arrowsize=0.9];

  /* ---------- marcos de capa ---------- */
  fui  [shape=box, style="filled", fillcolor="#E3F2FD", color="#7F7F7F", fixedsize=true, width=4.0, height=5.8, pos="4,4.5!", label="Presentación (paquete ui)", labelloc=t, fontsize=15];
  fapp [shape=box, style="filled", fillcolor="#E8F5E9", color="#7F7F7F", fixedsize=true, width=8.2, height=9.9, pos="19.55,4.45!", label="Aplicación (paquete application)", labelloc=t, fontsize=15];
  fdom [shape=box, style="filled", fillcolor="#FFF3E0", color="#7F7F7F", fixedsize=true, width=3.6, height=2.0, pos="27.6,4.5!", label="Dominio (paquete domain)", labelloc=t, fontsize=15];
  finf [shape=box, style="filled", fillcolor="#F3E5F5", color="#7F7F7F", fixedsize=true, width=3.6, height=2.0, pos="27.6,1.35!", label="Infraestructura                                  ", labelloc=b, fontsize=14];

  fcl  [shape=box, style="filled", fillcolor="#E0F7FA", color="#7F7F7F", fixedsize=true, width=2.9, height=4.6, pos="8.6,5.2!", label="Cliente HTTP (paquete client)", labelloc=t, fontsize=14];
  fapi [shape=box, style="filled", fillcolor="#E0F2F1", color="#7F7F7F", fixedsize=true, width=2.9, height=4.6, pos="12.9,5.2!", label="API REST (paquete api)", labelloc=t, fontsize=14];

  /* ---------- componentes ---------- */
  jugador [shape=box, style="rounded,filled", fillcolor=white, fixedsize=true, width=1.5, height=0.9, pos="-0.8,6.2!", label="«actor»\nJugador"];
  ui  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.9, height=1.6, pos="4,6.2!", label="Interfaz de usuario
(Swing + FlatLaf)
RF-33 a RF-41
RF-43, 48"];
  am  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.9, height=1.3, pos="4,2.8!", label="Gestor de assets
(AssetManager)
RF-42, 44"];
  pk  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.9, height=1.1, pos="4,0.0!", label="Sprites pixel-art propios\n(recursos assets/ del jar,\ngen_sprites.py)"];

  cl  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.5, height=1.3, pos="8.6,6.2!", label="Cliente del juego\n(RemoteGameClient)"];
  ebc [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.5, height=1.1, pos="8.6,3.9!", label="Bus de eventos\ndel cliente\n(EventBus)"];
  api [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.5, height=1.5, pos="12.9,6.2!", label="Controlador REST\n(GameRestController\n+ EventCollector)\nRNF-15"];

  gc  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.6, height=1.4, pos="17.2,6.2!", label="Controlador del juego\n(GameController)"];
  eb  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.4, height=1.1, pos="21.4,6.7!", label="Bus de eventos\ndel servidor\n(EventBus)"];

  sv  [shape=box, style="filled", fillcolor="#FFE9A8", color="#333333", fixedsize=true, width=7.2, height=3.8, pos="19.3,2.2!", label="«component»  Servicios de aplicación", labelloc=t, fontsize=14];
  s1  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.0, height=0.95, pos="17.2,2.75!",  label="Cultivo\nRF-01 a RF-07"];
  s2  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.0, height=0.95, pos="19.3,2.75!", label="Tiempo y clima\nRF-08 a RF-12, 17"];
  s3  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.0, height=0.95, pos="21.4,2.75!", label="Economía\nRF-13 a RF-16"];
  s4  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.0, height=0.95, pos="17.2,1.35!",  label="Construcción y\nanimales RF-18 a 25"];
  s5  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.0, height=0.95, pos="19.3,1.35!", label="Progreso\nRF-26 a RF-28"];
  s6  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.0, height=0.95, pos="21.4,1.35!", label="Guardado\nRF-29 a RF-32"];

  s7  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.6, height=1.1, pos="19.3,8.4!", label="Avatar y personajes
(NPC, encargos, tutorial)
RF-45 a RF-47
RF-49 a RF-50"];
  dom [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.6, height=1.3, pos="27.6,4.4!", label="Dominio del juego\nreglas y estado\nRN-01 a RN-40"];
  repo[shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.6, height=1.1, pos="27.6,1.3!", label="Repositorio de partidas\n(MongoSaveRepository)"];
  fs  [shape=component, style=filled, fillcolor="#FFF2CC", fixedsize=true, width=2.6, height=1.0, pos="27.6,-1.9!", label="«externo»\nMongoDB\n(colección partidas)"];

  /* ---------- puertos (cuadros en el borde del componente) ---------- */
  p_ui [shape=square, style=filled, fillcolor=white, fixedsize=true, width=0.2, pos="2.55,6.2!", label=""];
  p_cl [shape=square, style=filled, fillcolor=white, fixedsize=true, width=0.2, pos="7.35,6.2!", label=""];
  p_gc [shape=square, style=filled, fillcolor=white, fixedsize=true, width=0.2, pos="15.9,6.2!", label=""];

  /* ---------- interfaces (bolitas) ---------- */
  node [shape=circle, style=filled, fillcolor=white, fixedsize=true, width=0.3, label=""];
  i_user [pos="1.1,6.2!",  xlabel="Ratón y teclado"];
  i_as   [pos="4,4.55!",   xlabel="IAssetProvider"];
  i_af   [pos="4,1.35!",   xlabel="IAssetFiles (classpath)"];
  i_gc1  [pos="6.3,6.2!",  xlabel="IGameCommands"];
  i_http [pos="10.75,6.2!",xlabel="IApiRest (HTTP / JSON)"];
  i_gc2  [pos="14.95,6.2!",xlabel="IGameCommands"];
  i_es1  [pos="6.3,3.9!",  xlabel="IEventSubscription"];
  i_epc  [pos="8.6,5.05!", xlabel="IEventPublisher"];
  i_es   [pos="19.3,8.4!", xlabel="IEventSubscription"];
  i_sv   [pos="17.2,4.7!",  xlabel="IServicios"];
  i_ep   [pos="21.4,4.75!",xlabel="IEventPublisher      "];
  i_ru   [pos="24.7,4.4!", xlabel="IGameRules"];
  i_sn   [pos="27.6,2.85!",xlabel="IGameSnapshot"];
  i_re   [pos="24.7,1.3!", xlabel="ISaveRepository"];
  i_fs   [pos="27.6,-0.5!",xlabel="IMongoDB (protocolo MongoDB)"];

  /* ---------- conexiones ---------- */
  edge [color="#222222"];
  /* proveedor: línea simple hasta la bolita; consumidor: flecha con arco hacia la bolita */
  jugador -> i_user [style=dashed, arrowhead=vee, label="usa"];
  i_user -> p_ui [dir=none];
  ui -> p_ui [dir=none, style=invis];

  ui -> i_gc1 [arrowhead=ocurve, arrowsize=1.6];
  p_cl -> i_gc1 [dir=none];
  cl -> p_cl [dir=none, style=invis];

  cl -> i_http [arrowhead=ocurve, arrowsize=1.6];
  api -> i_http [dir=none];

  api -> i_gc2 [arrowhead=ocurve, arrowsize=1.6];
  p_gc -> i_gc2 [dir=none];
  gc -> p_gc [dir=none, style=invis];

  ui -> i_as [arrowhead=ocurve, arrowsize=1.6];
  am -> i_as [dir=none];
  am -> i_af [arrowhead=ocurve, arrowsize=1.6];
  pk -> i_af [dir=none];

  ui -> i_es1 [arrowhead=ocurve, arrowsize=1.6];
  ebc -> i_es1 [dir=none];
  cl -> i_epc [arrowhead=ocurve, arrowsize=1.6];
  ebc -> i_epc [dir=none];

  api -> i_es [arrowhead=ocurve, arrowsize=1.6];
  eb -> i_es [dir=none];

  gc -> i_sv [arrowhead=ocurve, arrowsize=1.6];
  gc -> s7 [dir=none, style=dashed];
  sv:n -> i_sv [dir=none];

  sv:n -> i_ep [arrowhead=ocurve, arrowsize=1.6];
  eb -> i_ep [dir=none];

  sv:e -> i_ru [arrowhead=ocurve, arrowsize=1.6];
  dom -> i_ru [dir=none];

  repo -> i_sn [arrowhead=ocurve, arrowsize=1.6];
  dom -> i_sn [dir=none];

  s6 -> i_re [arrowhead=ocurve, arrowsize=1.6];
  repo -> i_re [dir=none];

  repo -> i_fs [arrowhead=ocurve, arrowsize=1.6];
  fs -> i_fs [dir=none];

  leyenda [shape=plaintext, fixedsize=false, width=0.1, height=0.1, margin=0.05, pos="14.5,-1.7!", fontsize=13,
           label="○ interfaz provista (bolita)     ) interfaz requerida (arco)     ■ puerto     marco de color = capa de la arquitectura\lCliente y servidor tienen cada uno su bus de eventos: el servidor devuelve los eventos en la respuesta HTTP y el cliente los republica.\l"];
}
@enddot
