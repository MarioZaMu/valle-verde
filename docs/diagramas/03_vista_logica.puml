@startuml 03_vista_logica
/'
  Vista 3 — Lógica (diagrama de clases UML) con los 7 patrones de diseño señalados por estereotipo y color.
  Cubre: RF-01..RF-32 (modelo del juego), HU-01..HU-32; patrones: Singleton (HU-09), State (HU-03/05/21/09),
  Strategy (HU-11/15), Factory Method (HU-01), Builder (HU-18), Memento (HU-29/30), Observer (HU-34/35/39).
  Reglas del taller: sin rombos "de adorno"; composición solo cuando el ciclo de vida depende del todo;
  atributos privados (-); lo heredado no se repite; multiplicidades con "..".
'/
skinparam dpi 140
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam stereotypeFontSize 11
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 40
skinparam ArrowColor #333333
skinparam class {
  BorderColor #333333
  BackgroundColor white
}
skinparam package {
  BorderColor #9E9E9E
  FontStyle bold
}
left to right direction
hide empty members

title Vista lógica — Valle Verde (diagrama de clases y patrones de diseño)\n

package "ui  (presentación)" #F5FAFF {
  class HudPanel <<ConcreteObserver>> #BBDEFB
  class MapPanel <<ConcreteObserver>> #BBDEFB
  class MarketDialog {
    +onSellClicked(item: String, qty: int): void
  }
  class ToastPresenter <<ConcreteObserver>> #BBDEFB
  class ToastQueue {
    +post(kind: ToastKind, text: String): void
    +visible(): List<ToastView>
  }
  class ToastLayer
  class VisualEffects {
    +onWorld(season: String, weather: String): void
    +onMap(map: MapView): void
    +animalFrame(index: int): int
    +cropScale(col: int, row: int): float
  }
  class MapRenderer
  class AssetManager {
    +sprite(name: String): Optional<BufferedImage>
  }
  class ToolModel {
    +current(): Tool
    +selectedSeed(): String
  }
  class HudModel <<ConcreteObserver>> #BBDEFB {
    +energyText(): String
    +energyFraction(): double
  }
}

package "client  (cliente HTTP)" #F2FCFD {
  class RemoteGameClient {
    +newGame(seed: long): Result
    +hud(): Result
    +plant(col: int, row: int, crop: String): Result
  }
  class EventDecoder
}

package "api  (servidor REST)" #F2FBFA {
  class GameRestController {
    +newGame(seed: long): ResponseEntity
    +hud(): ResponseEntity
    +plant(col: int, row: int, crop: String): ResponseEntity
  }
  class ApiResponse
  class EventDto
  class ErrorStatusMapper
  class EventCollector <<ConcreteObserver>> #BBDEFB
}

package "application" #F6FBF6 {
  interface GameCommands {
    +sell(item: String, qty: int): Result
    +newGame(seed: long): Result
    +hasGameInProgress(): boolean
    +hud(): Result
    +hasSavedGames(): Result
    +plant(col: int, row: int, crop: String): Result
    +water(col: int, row: int): Result
    +harvest(col: int, row: int): Result
    +inspect(col: int, row: int): Result
    +map(): Result
  }
  class GameController <<Controller>> {
    +newGame(seed: long): Result
    +hasGameInProgress(): boolean
    +hud(): Result
    +hasSavedGames(): Result
    +plant(col: int, row: int, crop: String): Result
    +water(col: int, row: int): Result
    +harvest(col: int, row: int): Result
    +inspect(col: int, row: int): Result
    +map(): Result
    +endDay(): Result
    +sell(item: String, qty: int): Result
    +build(type: String, col: int, row: int): Result
    +buyAnimal(animal: String): Result
    +feed(building: int): Result
    +collect(building: int): Result
    +cure(building: int, animal: int): Result
    +save(slot: int): Result
    +load(slot: int): Result
  }
  class Result<T> {
    -ok: boolean
    -code: ErrorCode
    -message: String
    -value: T
    +isOk(): boolean
    +{static} ok(value: T): Result<T>
    +{static} fail(code: ErrorCode, msg: String): Result<T>
  }
  class GameSession {
    -state: GameState
    +current(): GameState
    +replace(s: GameState): void
  }
  class FarmService {
    +plant(col: int, row: int, seed: String): Result
    +water(col: int, row: int): Result
    +harvest(col: int, row: int): Result
    +inspect(col: int, row: int): Result
  }
  class ProgressService {
    +newGame(seed: long): Result
  }
  class DayService {
    +endDay(): Result
  }
  class MarketService {
    +sell(item: String, qty: int): Result
    +buy(item: String, qty: int): Result
  }
  class BuildingService {
    +build(type: String, col: int, row: int): Result
    +buildings(): Result
  }
  class AnimalService {
    +buyAnimal(animal: String): Result
    +feed(building: int): Result
    +collect(building: int): Result
    +cure(building: int, animal: int): Result
  }
  class SaveGameService <<Caretaker>> #F8BBD0 {
    +save(slot: int): Result
    +load(slot: int): Result
    +slots(): Result
  }
  class AchievementService {
    +check(s: GameState): void
    +achievements(): Result
  }
  class EventBus <<Subject>> #BBDEFB {
    -listeners: List<GameListener>
    +subscribe(l: GameListener): void
    +publish(e: GameEvent): void
  }
  interface GameListener <<Observer>> #BBDEFB {
    +onEvent(e: GameEvent): void
  }
  interface GameEvent
  note bottom of DayService
    FarmService, BuildingService,
    AnimalService y ProgressService
    son análogos (un servicio por bloque funcional)
  end note
}

package "domain" #FFFCF5 {

  package "game" #FFFFFF {
    class GameState <<Originator>> #F8BBD0 {
      -money: int
      -energy: int
      +createMemento(): GameMemento
      +restore(m: GameMemento): void
      +spend(amount: int): boolean
      +earn(amount: int): void
    }
    class Energy {
      -current: int
      +trySpend(cost: int): boolean
      +restore(): void
    }
    interface DayStep {
      +phase(): DayPhase
      +apply(s: GameState, r: DayReport): void
    }
    class DayPipeline {
      +add(step: DayStep): DayPipeline
      +run(s: GameState): DayReport
    }
    class GameStateValidator {
      +{static} violations(m: GameMemento): List<String>
    }
    class GameMemento <<Memento>> #F8BBD0 {
      -snapshot: Object
    }
  }

  package "save" #FFFFFF {
    interface SaveRepository <<Port>> {
      +save(slot: int, m: GameMemento, at: Instant): void
      +load(slot: int): GameMemento
      +slots(): List<SlotInfo>
    }
    class SlotInfo <<ValueObject>> {
      -status: Status
      -money: int
    }
    class SaveLoadException {
      -reason: Reason
    }
  }

  package "time" #FFFFFF {
    class GameClock <<Singleton>> #FFCCBC {
      -{static} instance: GameClock
      -day: int
      -year: int
      -season: SeasonState
      +{static} getInstance(): GameClock
      +advanceDay(): void
    }
    interface SeasonState <<State>> #C8E6C9 {
      +next(): SeasonState
      +weatherStrategy(): WeatherStrategy
    }
    class SpringState <<ConcreteState>> #C8E6C9
    class SummerState <<ConcreteState>> #C8E6C9
    class AutumnState <<ConcreteState>> #C8E6C9
    class WinterState <<ConcreteState>> #C8E6C9
    class WeatherCycle {
      -today: Weather
      -forecast: Weather
      +advance(c: GameClock, rnd: Random): void
    }
    class StateRandom {
      -state: long
      +state(): long
      +restore(s: long): void
    }
    interface WeatherStrategy <<Strategy>> #FFF9C4 {
      +nextWeather(day: int, rnd: Random): Weather
    }
    class SeasonalWeatherStrategy <<ConcreteStrategy>> #FFF9C4
    class FixedWeatherStrategy <<ConcreteStrategy>> #FFF9C4
  }

  package "farm" #FFFFFF {
    class FarmMap {
      -cols: int
      -rows: int
      +plotAt(col: int, row: int): Plot
      +growCrops(w: Weather): int
      +witherOutOfSeason(s: Season): int
    }
    class Plot {
      -terrain: Terrain
      +isFree(): boolean
    }
  }

  package "crop" #FFFFFF {
    class Crop <<Context>> #C8E6C9 {
      -daysGrown: int
      -daysWithoutWater: int
      -watered: boolean
      +water(): boolean
      +endOfDay(dryDays: int): void
      +witherIfOutOfSeason(s: Season): boolean
    }
    interface CropState <<State>> #C8E6C9 {
      +onDayEnd(c: Crop, dryDays: int): void
      +canHarvest(): boolean
    }
    class SeedState <<ConcreteState>> #C8E6C9
    class SproutState <<ConcreteState>> #C8E6C9
    class GrowingState <<ConcreteState>> #C8E6C9
    class MatureState <<ConcreteState>> #C8E6C9
    class WitheredState <<ConcreteState>> #C8E6C9
    abstract class CropFactory <<FactoryMethod>> #E1BEE7 {
      +{abstract} createCrop(): Crop
    }
    class CarrotFactory <<ConcreteCreator>> #E1BEE7
    class PumpkinFactory <<ConcreteCreator>> #E1BEE7
  }

  package "building" #FFFFFF {
    class Building <<Product>> #B2DFDB {
      -col: int
      -row: int
      -width: int
      -height: int
      +addAnimal(a: Animal): boolean
      +collectAll(): int
    }
    class BuildingType <<enumeration>> {
      COOP
      BARN
      WAREHOUSE
      GREENHOUSE
    }
    abstract class BuildingBuilder <<Builder>> #B2DFDB {
      +placeAt(id: int, col: int, row: int): void
      +defineHousing(): void
      +defineEffects(): void
      +result(): Building
    }
    class CoopBuilder <<ConcreteBuilder>> #B2DFDB
    class BarnBuilder <<ConcreteBuilder>> #B2DFDB
    class WarehouseBuilder <<ConcreteBuilder>> #B2DFDB
    class GreenhouseBuilder <<ConcreteBuilder>> #B2DFDB
    class BuildingDirector <<Director>> #B2DFDB {
      +{static} construct(type: BuildingType, id: int, col: int, row: int): Building
    }
  }

  package "animal" #FFFFFF {
    class Animal <<Context>> #C8E6C9 {
      -daysWithoutFood: int
      -fedToday: boolean
      -pending: int
      +feed(): boolean
      +cure(): boolean
      +endOfDay(): void
    }
    class AnimalType <<enumeration>> {
      HEN
      COW
    }
    interface AnimalState <<State>> #C8E6C9 {
      +onDayEnd(a: Animal): void
      +canEat(): boolean
    }
    class HealthyState <<ConcreteState>> #C8E6C9
    class HungryState <<ConcreteState>> #C8E6C9
    class SickState <<ConcreteState>> #C8E6C9
  }

  package "economy" #FFFFFF {
    class Inventory {
      -capacity: int
      +add(item: String, qty: int): boolean
      +remove(item: String, qty: int): boolean
      +count(item: String): int
    }
    class Market <<Context>> #FFF9C4 {
      -demand: Map<String, Integer>
      +unitPrice(item: String): int
      +sellUnit(item: String): int
      +recoverDemand(): void
    }
    interface PricingStrategy <<Strategy>> #FFF9C4 {
      +price(item: String, demand: int, s: SeasonState): int
    }
    class CropPricing <<ConcreteStrategy>> #FFF9C4
    class FlatPricing <<ConcreteStrategy>> #FFF9C4
  }

  package "progress" #FFFFFF {
    class AchievementTracker {
      -harvests: int
      -unitsSold: int
      +evaluate(f: ProgressFacts): List<Achievement>
    }
    class Achievement <<enumeration>> {
      LG-01..LG-09
    }
    class ProgressFacts <<ValueObject>> {
      -money: int
      -harvests: int
      -unitsSold: int
      -year: int
    }
  }
}

package "infrastructure" #FBF5FC {
  class MongoSaveRepository
  class SaveDocument
  class SaveCodec {
    +encode(slot: int, m: GameMemento, at: Instant): SaveDocument
    +decode(d: SaveDocument): GameMemento
  }
  class Checksum {
    +{static} of(text: String): String
  }
}

' ---------- Observer ----------
EventBus o-- "0..*" GameListener
EventBus ..> GameEvent : publica
HudPanel ..|> GameListener
HudModel ..|> GameListener
MapPanel ..|> GameListener
ToastPresenter ..|> GameListener
ToastPresenter --> ToastQueue
ToastLayer --> ToastQueue : dibuja
MapPanel --> VisualEffects
MapPanel --> MapRenderer
MapRenderer --> AssetManager : sprites o vectores
MapRenderer ..> VisualEffects : lee
MapPanel ..> GameCommands : usa
MarketDialog ..> GameCommands : usa

' ---------- Aplicación ----------
GameController --> ProgressService
GameController --> FarmService
GameController --> DayService
GameController --> MarketService
GameController --> BuildingService
GameController --> AnimalService
GameController --> SaveGameService
GameController ..> Result : devuelve
DayService --> GameSession
DayService --> DayPipeline
ProgressService --> GameSession
FarmService --> GameSession
FarmService --> EventBus
ProgressService --> EventBus
DayService --> EventBus
MarketService --> GameSession
MarketService --> EventBus
MarketService --> AchievementService
FarmService --> AchievementService
BuildingService --> AchievementService
AnimalService --> AchievementService
DayService --> AchievementService
AchievementService --> GameSession
AchievementService --> EventBus
BuildingService --> GameSession
BuildingService --> EventBus
AnimalService --> GameSession
AnimalService --> EventBus

' ---------- Dominio: agregado ----------
GameState *-- "1" FarmMap
GameState *-- "1" Inventory
GameState *-- "1" Market
GameState *-- "1" AchievementTracker
GameState ..> ProgressFacts : «create»
AchievementTracker ..> ProgressFacts : lee
GameSession --> "1" GameState : actual
GameState ..> GameClock : usa
GameState *-- "1" StateRandom
GameState *-- "1" Energy
GameState *-- "1" WeatherCycle
DayPipeline o-- "0..*" DayStep
WeatherCycle ..> WeatherStrategy : usa
FarmMap *-- "160" Plot
FarmMap *-- "0..*" Building
Plot *-- "0..1" Crop
Building *-- "0..4" Animal

' ---------- Singleton / State (estación) / Strategy (clima) ----------
GameClock o-- "1" SeasonState
SeasonState <|.. SpringState
SeasonState <|.. SummerState
SeasonState <|.. AutumnState
SeasonState <|.. WinterState
SeasonState ..> WeatherStrategy : elige
SeasonalWeatherStrategy ..> StateRandom : sortea con
WeatherStrategy <|.. SeasonalWeatherStrategy
WeatherStrategy <|.. FixedWeatherStrategy

' ---------- State (cultivo) + Factory Method ----------
Crop o-- "1" CropState
CropState <|.. SeedState
CropState <|.. SproutState
CropState <|.. GrowingState
CropState <|.. MatureState
CropState <|.. WitheredState
CropFactory <|-- CarrotFactory
CropFactory <|-- PumpkinFactory
CropFactory ..> Crop : «create»

' ---------- State (animal) ----------
Animal o-- "1" AnimalState
AnimalState <|.. HealthyState
AnimalState <|.. HungryState
AnimalState <|.. SickState

' ---------- Builder ----------
BuildingBuilder <|-- CoopBuilder
BuildingBuilder <|-- BarnBuilder
BuildingBuilder <|-- WarehouseBuilder
BuildingBuilder <|-- GreenhouseBuilder
BuildingBuilder ..> Building : «create»
BuildingDirector ..> BuildingBuilder : elige y dirige
Building ..> BuildingType
BuildingType ..> AnimalType : aloja
AchievementTracker o-- "0..*" Achievement

' ---------- Strategy (precios) ----------
Market o-- "1" PricingStrategy
PricingStrategy <|.. CropPricing
PricingStrategy <|.. FlatPricing

' ---------- Memento ----------
GameState ..> GameMemento : «create»
SaveGameService --> GameSession
SaveGameService ..> GameMemento : conserva
SaveGameService --> SaveRepository
MongoSaveRepository ..|> SaveRepository
MongoSaveRepository ..> SaveDocument : lee y escribe
MongoSaveRepository --> SaveCodec
SaveCodec ..> Checksum : calcula
SaveGameService ..> GameStateValidator : valida
SaveRepository ..> SlotInfo : lista
SaveRepository ..> SaveLoadException : lanza
GameController --> AchievementService

' ---------- Cliente y servidor (RNF-15) ----------
GameController ..|> GameCommands
RemoteGameClient ..|> GameCommands
RemoteGameClient ..> EventDecoder
RemoteGameClient ..> EventBus : republica eventos
GameRestController --> GameCommands
GameRestController --> EventCollector
GameRestController ..> ApiResponse : responde
GameRestController ..> ErrorStatusMapper
ApiResponse o-- "0..*" EventDto
EventCollector ..|> GameListener
SaveRepository ..> GameMemento

legend right
  <b>Patrones (color)</b>
  <back:#FFCCBC>  Singleton  </back>
  <back:#C8E6C9>  State  </back>
  <back:#FFF9C4>  Strategy  </back>
  <back:#E1BEE7>  Factory Method  </back>
  <back:#B2DFDB>  Builder  </back>
  <back:#F8BBD0>  Memento  </back>
  <back:#BBDEFB>  Observer  </back>
endlegend
@enduml
