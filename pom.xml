<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>edu.ucc</groupId>
  <artifactId>farmsim</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>farmsim</name>
  <description>2D turn-based farm simulator (course project: Software Design, UCC Pasto)</description>

  <properties>
    <!-- Java 17 bytecode; runs on JRE 17 or newer (the dev machine has JDK 25) -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- versions verified on Maven Central (2026-11-22) -->
    <gson.version>2.15.0</gson.version>
    <junit.version>5.14.4</junit.version>
    <archunit.version>1.5.1</archunit.version>
    <jacoco.version>0.8.16</jacoco.version>
    <compiler.plugin.version>3.16.0</compiler.plugin.version>
    <surefire.plugin.version>3.6.1</surefire.plugin.version>
    <shade.plugin.version>3.6.2</shade.plugin.version>

    <main.class>edu.ucc.farmsim.Main</main.class>
    <!-- fast build by default; the "perf" profile also runs @Tag("perf") tests -->
    <test.excluded.groups>perf</test.excluded.groups>
    <!-- filled in by the JaCoCo agent; empty default keeps surefire happy when the agent is skipped -->
    <argLine></argLine>
    <!-- minimum line coverage for the domain and application layers (RNF-05) -->
    <coverage.minimum>0.70</coverage.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
      <exclusions>
        <!-- compile-time annotations only; not needed at runtime -->
        <exclusion>
          <groupId>com.google.errorprone</groupId>
          <artifactId>error_prone_annotations</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>farmsim</finalName>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler.plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.plugin.version}</version>
        <configuration>
          <argLine>@{argLine}</argLine>
          <excludedGroups>${test.excluded.groups}</excludedGroups>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <!-- two separate gates: each layer must reach the minimum on its own (RNF-05) -->
          <execution>
            <id>check-domain</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <includes><include>edu/ucc/farmsim/domain/**</include></includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>check-application</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <includes><include>edu/ucc/farmsim/application/**</include></includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- single executable jar: java -jar target/farmsim.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${shade.plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn verify -Pperf : also runs the performance tests (RNF-01, RNF-03) -->
    <profile>
      <id>perf</id>
      <properties>
        <test.excluded.groups>none-excluded</test.excluded.groups>
      </properties>
    </profile>
  </profiles>
</project>
