@startuml 04_vista_desarrollo
/'
  Vista 4 — Desarrollo (paquetes y dependencias del código fuente)
  Cubre: RNF-06 (sentido de las dependencias), RNF-12, R-02; estructura de paquetes que seguirán las HU-01..HU-42.
  Notación de la guía: paquete = carpeta con pestaña; flecha punteada A ..> B = "A importa clases de B" (apunta a quien se usa).
  Reglas: ui → application → domain · infrastructure → domain · el dominio no depende de nadie · sin ciclos ·
  la UI nunca importa domain ni infrastructure · el controlador nunca salta al repositorio.
'/
skinparam dpi 140
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam packageStyle folder
skinparam nodesep 22
skinparam ranksep 38
skinparam ArrowColor #333333
skinparam package {
  BorderColor #7F7F7F
  FontStyle bold
}
skinparam class {
  BorderColor #555555
  BackgroundColor white
}
hide circle
hide members
hide empty members
top to bottom direction

title Vista de desarrollo — Valle Verde (paquetes edu.ucc.farmsim y dependencias)\n

package "edu.ucc.farmsim" as ROOT #FFFFFF {

  class Main <<composición>>
  class LaunchOptions
  class GameInfo

  package "ui" as UI #E3F2FD {
    package "screens" as UI_SCR #FFFFFF {
      class MainWindow
      class ScreenRouter
      class StartScreenPresenter
      class StartScreen
      class GameScreen
    }
    package "components" as UI_CMP #FFFFFF {
      class HudPanel
      class HudModel
      class ToolModel
      class ToolBar
      class PlotText
      class InventoryGrid
      class InventoryModel
      class InventoryDialog
      class MarketPresenter
      class MarketDialog
      class ToastLayer
      class ToastQueue
      class ToastPresenter
      class ToastKind
      class ToastView
      class OverlayPanel
      class WoodBox
      class WoodButton
      class WoodSlot
      class EnergyBar
    }
    package "render" as UI_REN #FFFFFF {
      class MapPanel
      class MapRenderer
      class MapGeometry
      class VisualEffects
      class Particle
      class SeasonPalette
      class GroundLayer
      class PixelScaler
      class AmbientPainter
      class TitleScene
    }
    package "assets" as UI_AST #FFFFFF {
      class AssetManager
    }
    package "theme" as UI_THM #FFFFFF {
      class Texts
      class Palette
      class UiTheme
      class WoodStyle
      class HoverAnimator
    }
  }

  package "client" as CLI #E0F7FA {
    class RemoteGameClient
    class EventDecoder
  }

  package "api" as API #E0F2F1 {
    class GameRestController
    class ApiResponse
    class EventDto
    class ErrorStatusMapper
    class EventCollector
    class ApiExceptionHandler
  }

  package "config" as CFG #FFFDE7 {
    class ServerApplication
    class ServerConfig
  }

  package "application" as APP #E8F5E9 {
    package "controller" as APP_CTL #FFFFFF {
      class GameCommands
      class GameController
    }
    package "service" as APP_SRV #FFFFFF {
      class FarmService
      class DayService
      class MarketService
      class BuildingService
      class AnimalService
      class AchievementService
      class SaveGameService
      class ProgressService
      class AvatarService
      class ViewMapper
      class GameSession
    }
    package "event" as APP_EVT #FFFFFF {
      class EventBus
      class GameListener
      class GameEvent
    }
    package "dto" as APP_DTO #FFFFFF {
      class HudView
      class MapView
      class GameView
      class PlotView
      class AvatarView
    }
    package "result" as APP_RES #FFFFFF {
      class Result
      class ErrorCode
      class Messages
      class Names
    }
  }

  package "domain" as DOM #FFF3E0 {
    package "game" as D_GAME #FFFFFF {
      class GameState
      class GameMemento
      class Energy
      class DayPipeline
      class GameStateValidator
    }
    package "save" as D_SAVE #FFFFFF {
      class SaveRepository
      class SlotInfo
      class SaveLoadException
    }
    package "farm" as D_FARM #FFFFFF {
      class FarmMap
      class Plot
      class Avatar
      class Direction
    }
    package "crop" as D_CROP #FFFFFF {
      class Crop
      class CropType
      class CropFactory
    }
    package "building" as D_BLD #FFFFFF {
      class Building
      class BuildingType
      class BuildingBuilder
      class CoopBuilder
      class BarnBuilder
      class WarehouseBuilder
      class GreenhouseBuilder
      class BuildingDirector
    }
    package "animal" as D_ANI #FFFFFF {
      class Animal
      class AnimalType
      class AnimalState
      class HealthyState
      class HungryState
      class SickState
    }
    package "economy" as D_ECO #FFFFFF {
      class Market
      class Inventory
      class ItemType
      class Trend
      class PricingStrategy
      class CropPricing
      class FlatPricing
    }
    package "time" as D_TIM #FFFFFF {
      class GameClock
      class SeasonState
      class StateRandom
      class WeatherCycle
    }
    package "progress" as D_PRO #FFFFFF {
      class AchievementTracker
      class Achievement
      class ProgressFacts
    }
    package "config" as D_CFG #FFFFFF {
      class GameRules
    }
  }

  package "infrastructure" as INF #F3E5F5 {
    package "persistence" as INF_PER #FFFFFF {
      class MongoSaveRepository
      class SaveDocument
      class SaveCodec
      class Checksum
    }
  }
}


' ---------- Pistas de disposición (enlaces ocultos: apilan las capas de arriba hacia abajo) ----------
Main -[hidden]down-> StartScreen
AssetManager -[hidden]down-> GameController
Palette -[hidden]down-> GameController
Result -[hidden]down-> GameRules
GameEvent -[hidden]down-> SaveRepository
ErrorCode -[hidden]down-> SaveRepository
Animal -[hidden]down-> MongoSaveRepository
GameClock -[hidden]down-> MongoSaveRepository
WeatherCycle -[hidden]down-> MongoSaveRepository
ItemType -[hidden]down-> MongoSaveRepository

' ---------- Raíz de composición ----------
Main .down.> UI
Main ..> CLI
Main ..> CFG
Main ..> APP
Main ..> DOM
Main ..> INF

' ---------- Capas ----------
UI .down.> APP
CLI .down.> APP
API .down.> APP
CFG .down.> APP
CFG .down.> DOM
APP .down.> DOM
INF .up.> DOM

' ---------- Dentro de ui ----------
UI_SCR .down.> UI_CMP
UI_SCR .down.> UI_REN
UI_CMP .down.> UI_THM
UI_CMP .down.> UI_AST
UI_REN .down.> UI_AST
UI_REN .down.> UI_THM

' ---------- Dentro de application ----------
APP_CTL .down.> APP_SRV
APP_CTL .down.> APP_RES
APP_SRV .down.> APP_EVT
APP_SRV .down.> APP_DTO
APP_SRV .down.> APP_RES

' ---------- Dentro de domain (todos usan config; sin ciclos) ----------
D_GAME .down.> D_FARM
D_GAME .down.> D_ECO
D_GAME .down.> D_TIM
D_GAME .down.> D_PRO
D_SAVE .down.> D_GAME
D_FARM .down.> D_CROP
D_FARM .down.> D_BLD
D_FARM .down.> D_TIM
D_BLD .down.> D_ANI
D_BLD .down.> D_ECO
D_BLD .down.> D_PRO
D_ANI .down.> D_ECO
D_GAME .down.> D_ANI
D_GAME .down.> D_CROP
D_SAVE .down.> D_TIM
D_GAME .down.> D_BLD
D_CROP .down.> D_TIM
D_ECO .down.> D_CROP
D_ECO .down.> D_TIM

' ---------- Dentro de infrastructure ----------
INF_PER .down.> D_SAVE

note right of D_CFG
  <b>domain.config</b> (GameRules): constantes de RN-01..RN-35.
  Todos los paquetes de domain la usan;
  ella no depende de nadie.
end note

note bottom of INF
  MongoSaveRepository implementa
  domain.save.SaveRepository
  (inversión de dependencias).
end note

legend right
  <b>Lectura</b>
  A ..> B  significa «A importa clases de B».
  <b>Prohibido</b> (lo verifica la prueba de arquitectura):
  ui → domain · ui → infrastructure · ui → api · client → api · api → domain · domain → cualquier otra capa
  application → infrastructure · controller → repository · ciclos
endlegend
@enduml
