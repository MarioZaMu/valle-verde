@startdot
/'
  Vista 1 — Contexto (DFD nivel 0)  ·  Cubre: OBJ-01, alcance de VISION_ALCANCE §4-5; HU-29, HU-30, HU-45, HU-46, HU-49
  Reglas (guía del curso): un solo círculo, sin nada dentro; una caja por entidad externa;
  una flecha por dato y dirección rotulada con sustantivo; sin flechas entre entidades externas.
  Fase 5.7: las partidas viven en MongoDB (no en archivos) y los sprites son propios y van dentro del jar,
  así que ya no son una entidad externa.
  Posiciones fijadas a mano (layout=neato, pos="x,y!") para que ningún rótulo se superponga.
'/
digraph contexto {
  graph [layout=neato, splines=true, pad=0.6, fontname="Arial", dpi=150, outputorder=edgesfirst, forcelabels=true,
         label="Vista de contexto — Valle Verde (DFD nivel 0)\n ", labelloc=t, fontsize=24];
  node  [fontname="Arial", fontsize=15];
  edge  [fontname="Arial", fontsize=13, arrowsize=1.1, penwidth=1.6];

  jugador [label="Jugador", shape=box, width=2.34, height=0.9, pos="-1.5,2.2!", style=filled, fillcolor="#FFF8E1"];
  mongo   [label="MongoDB\n(servidor local)", shape=box, width=2.6, height=1.1, pos="12.5,2.2!", style=filled, fillcolor="#FFF8E1"];

  sistema [label="Valle Verde\n\nSimulador de granja\npor turnos", shape=circle, width=3.3, fixedsize=true,
           pos="5.5,2.2!", style=filled, fillcolor="#E8F5E9", penwidth=2.6, fontsize=18];

  jugador:ne -> sistema:nw [label="Órdenes de juego\n(caminar, herramienta, hablar con vecinos,\ncompras y ventas, terminar día,\nguardar, cargar, pasos del tutorial)\n "];
  sistema:sw -> jugador:se [label=" \nEstado y notificaciones\n(valle, HUD, inventario, diálogos,\nencargos, logros, tutorial y errores)"];

  sistema:ne -> mongo:nw [label="Partida guardada\n(ranura, documento + checksum)\n "];
  mongo:sw -> sistema:se [label=" \nPartida cargada\n(documento + checksum)"];
}
@enddot
